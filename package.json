{
    "name": "rider-cli",
    "version": "1.3.1",
    "description": "Rider Command Line Tool",
    "type": "module",
    "main": "index.mjs",
    "bin": {
        "rider": "./index.mjs"
    },
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
